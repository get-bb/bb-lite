#!/bin/sh
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)
if [ -f "$root/dist/bb.mjs" ]; then
  exec node "$root/dist/bb.mjs" "$@"
fi
exec node --conditions=source \
  --import "$root/../../node_modules/tsx/dist/loader.mjs" \
  "$root/src/index.ts" "$@"
