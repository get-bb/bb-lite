{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-next",
  "main": "./src/worker.ts",
  "account_id": "7bb84c630057dafa53e2aacbe6bd094f",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }],
  },
  "vars": {
    "BASE_DOMAIN": "getbb.dev",
    "HOSTING": "approved",
    "ADMIN_LOGIN": "SawyerHood",
    "FLY_ORG": "bb-953",
    "FLY_IMAGE": "registry.fly.io/bb-next-image:latest",
    "FLY_REGION": "iad",
    "FLY_CPU_KIND": "shared",
    "FLY_CPUS": "4",
    "FLY_MEMORY_MB": "8192",
    "FLY_VOLUME_GB": "20",
    "HOSTED_IDLE_HOURS": "24",
    "HOSTED_DELETE_DAYS": "30",
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-next",
      "database_id": "82625a6c-04c7-4a8b-b38a-669c1cb72952",
      "migrations_dir": "./migrations",
    },
  ],
  "routes": [
    { "pattern": "getbb.dev", "custom_domain": true },
    { "pattern": "*.getbb.dev/*", "zone_name": "getbb.dev" },
  ],
}
