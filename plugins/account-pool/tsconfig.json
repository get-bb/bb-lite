{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/components/ui/icon": [
        "../../packages/shared-ui/src/components/ui/icon.tsx"
      ],
      "@/*": [
        "../../packages/shared-ui/src/*"
      ]
    },
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "src/**/*.ts",
    "app.tsx"
  ]
}
