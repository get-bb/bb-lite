{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node"],
    "customConditions": ["source"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "app.tsx"]
}
