{
  "name": "@bb/plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "source": "./src/app.ts",
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "api:lock": "tsx scripts/api-lock.ts"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/server-contract": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/runner": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "hono": "^4.7.0",
    "ws": "^8.19.0"
  }
}
