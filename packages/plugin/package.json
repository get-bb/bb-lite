      "source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/sdk": "workspace:*",
    "@bb/server-contract": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0"
  }
